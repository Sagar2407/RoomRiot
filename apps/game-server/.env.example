# Room Riot game server configuration (all optional for local dev).

# Port the game server listens on.
PORT=4000
HOST=0.0.0.0

# HMAC secret for signed guest/member/display tokens.
# Set a stable value in production so tokens survive restarts.
ROOM_RIOT_SECRET=change-me-in-production

# SQLite database file. Use :memory: for ephemeral runs/tests.
ROOM_RIOT_DB=./data/room-riot.sqlite

# Allowed browser origin for CORS + Socket.IO. Use * to allow any (dev only).
WEB_ORIGIN=http://localhost:3000

# Abandoned-room inactivity window in ms (default 2h, blueprint §10).
ROOM_TTL_MS=7200000
